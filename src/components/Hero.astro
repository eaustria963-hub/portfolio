---
import { siteConfig } from '../config/site';
---

<section class="hero-section" aria-labelledby="hero-title">
  <!-- Ambient Emerald Glow Behind Hero Text -->
  <div class="ambient-glow" aria-hidden="true"></div>

  <!-- Decorative Inline SVG System Map -->
  <div class="system-map-container" aria-hidden="true">
    <svg
      class="system-map"
      viewBox="0 0 880 580"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- Soft Glow Filters -->
        <filter id="node-glow" x="-50%" y="-50%" width="200%" height="200%">
          <feGaussianBlur stdDeviation="3" result="blur" />
          <feMerge>
            <feMergeNode in="blur" />
            <feMergeNode in="SourceGraphic" />
          </feMerge>
        </filter>
        <linearGradient id="line-gradient-1" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="var(--emerald)" stop-opacity="0.4" />
          <stop offset="100%" stop-color="var(--emerald-soft)" stop-opacity="0.6" />
        </linearGradient>
      </defs>

      <!-- Connecting Circuit Lines (Draw on load once) -->
      <g class="circuit-lines">
        <!-- AI to CRM -->
        <path class="map-line line-1" d="M 380 200 L 260 280" />
        <!-- AI to Workflows -->
        <path class="map-line line-2" d="M 380 200 L 520 140" />
        <!-- Workflows to Pipelines -->
        <path class="map-line line-3" d="M 520 140 L 720 180" />
        <!-- CRM to Pipelines -->
        <path class="map-line line-4" d="M 260 280 L 720 180" />
        <!-- CRM to Forms -->
        <path class="map-line line-5" d="M 260 280 L 160 420" />
        <!-- CRM to Calendars -->
        <path class="map-line line-6" d="M 260 280 L 640 330" />
        <!-- Calendars to SMS -->
        <path class="map-line line-7" d="M 640 330 L 400 460" />
        <!-- Workflows to API -->
        <path class="map-line line-8" d="M 520 140 L 760 460" />
        <!-- Forms to SMS -->
        <path class="map-line line-9" d="M 160 420 L 400 460" />
        <!-- API to SMS -->
        <path class="map-line line-10" d="M 760 460 L 400 460" />

        <!-- Traveling Pulse Line (Continuous faint loop along key circuit) -->
        <path
          class="pulse-line"
          d="M 380 200 L 520 140 L 720 180 L 640 330 L 760 460"
        />
      </g>

      <!-- System Map Nodes (Fade in staggered) -->
      <g class="map-nodes">
        <!-- 1. AI -->
        <g class="node-group node-ai" transform="translate(380, 200)">
          <circle class="node-halo" r="9" />
          <circle class="node-core active" r="4" filter="url(#node-glow)" />
          <text class="node-label" x="12" y="4">AI</text>
        </g>

        <!-- 2. Workflows -->
        <g class="node-group node-workflows" transform="translate(520, 140)">
          <circle class="node-halo" r="9" />
          <circle class="node-core active" r="4" filter="url(#node-glow)" />
          <text class="node-label" x="12" y="4">Workflows</text>
        </g>

        <!-- 3. Pipelines -->
        <g class="node-group node-pipelines" transform="translate(720, 180)">
          <circle class="node-halo" r="8" />
          <circle class="node-core" r="3.5" />
          <text class="node-label" x="12" y="4">Pipelines</text>
        </g>

        <!-- 4. CRM -->
        <g class="node-group node-crm" transform="translate(260, 280)">
          <circle class="node-halo" r="11" />
          <circle class="node-core active" r="4.5" filter="url(#node-glow)" />
          <text class="node-label" x="14" y="4">CRM</text>
        </g>

        <!-- 5. Calendars -->
        <g class="node-group node-calendars" transform="translate(640, 330)">
          <circle class="node-halo" r="8" />
          <circle class="node-core" r="3.5" />
          <text class="node-label" x="12" y="4">Calendars</text>
        </g>

        <!-- 6. Forms -->
        <g class="node-group node-forms" transform="translate(160, 420)">
          <circle class="node-halo" r="8" />
          <circle class="node-core" r="3.5" />
          <text class="node-label" x="12" y="4">Forms</text>
        </g>

        <!-- 7. SMS -->
        <g class="node-group node-sms" transform="translate(400, 460)">
          <circle class="node-halo" r="8" />
          <circle class="node-core" r="3.5" />
          <text class="node-label" x="12" y="4">SMS</text>
        </g>

        <!-- 8. API -->
        <g class="node-group node-api" transform="translate(760, 460)">
          <circle class="node-halo" r="9" />
          <circle class="node-core active" r="4" filter="url(#node-glow)" />
          <text class="node-label" x="12" y="4">API</text>
        </g>
      </g>
    </svg>
  </div>

  <!-- Hero Content (Foreground, Asymmetrical Left-Aligned) -->
  <div class="hero-container">
    <div class="hero-content">
      <!-- Status Indicator -->
      <div class="status-indicator">
        <span class="status-beacon" aria-hidden="true">
          <span class="beacon-ring"></span>
          <span class="beacon-dot"></span>
        </span>
        <span class="status-text">SYSTEMS ONLINE</span>
      </div>

      <!-- Role Line (3 Atomic Units that wrap together, but wrap normally <480px to prevent overflow) -->
      <p class="role-line">
        {
          siteConfig.roleParts.map((part, index) => (
            <>
              <span class="role-unit">{part}</span>
              {index < siteConfig.roleParts.length - 1 && (
                <span class="role-separator" aria-hidden="true">
                  {' '}
                  ·{' '}
                </span>
              )}
            </>
          ))
        }
      </p>

      <!-- Syne Headline with Animated "invisible" Word -->
      <h1 id="hero-title" class="hero-headline">
        The <span class="word-invisible">invisible</span> engine behind your business.
      </h1>

      <!-- Supporting Line -->
      <p class="supporting-line">
        {siteConfig.supportingLine}
      </p>

      <!-- Two Actions -->
      <div class="hero-actions">
        <a href="/projects" class="action-btn action-primary">
          <span>View projects</span>
          <svg
            class="action-arrow"
            width="14"
            height="14"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8H13M13 8L8.5 3.5M13 8L8.5 12.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>

        <a href="/#contact" class="action-btn action-secondary">
          <span>Contact</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero Section Wrapper */
  .hero-section {
    position: relative;
    min-height: calc(100vh - 65px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background-color: var(--bg);
    padding: 3rem 1.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  /* Ambient Emerald Glow Behind Text */
  .ambient-glow {
    position: absolute;
    top: 35%;
    left: 15%;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      rgba(15, 92, 72, 0.16) 0%,
      rgba(13, 18, 17, 0.05) 50%,
      transparent 75%
    );
    pointer-events: none;
    z-index: 0;
    transform: translate(-30%, -30%);
  }

  /* Decorative System Map SVG */
  .system-map-container {
    position: absolute;
    right: -2%;
    top: 50%;
    transform: translateY(-50%);
    width: 65%;
    max-width: 950px;
    min-width: 500px;
    height: auto;
    pointer-events: none;
    z-index: 0;
    opacity: 0.85;
  }

  .system-map {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Circuit Lines Animation (Drawing on load) */
  .map-line {
    stroke: var(--line);
    stroke-width: 1;
    fill: none;
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: drawLine 2s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  .line-1 { animation-delay: 0.1s; stroke: rgba(46, 139, 110, 0.35); }
  .line-2 { animation-delay: 0.2s; stroke: rgba(46, 139, 110, 0.45); }
  .line-3 { animation-delay: 0.3s; stroke: rgba(26, 38, 35, 0.7); }
  .line-4 { animation-delay: 0.35s; stroke: rgba(15, 92, 72, 0.4); }
  .line-5 { animation-delay: 0.4s; stroke: rgba(26, 38, 35, 0.7); }
  .line-6 { animation-delay: 0.45s; stroke: rgba(46, 139, 110, 0.3); }
  .line-7 { animation-delay: 0.5s; stroke: rgba(26, 38, 35, 0.7); }
  .line-8 { animation-delay: 0.55s; stroke: rgba(46, 139, 110, 0.4); }
  .line-9 { animation-delay: 0.6s; stroke: rgba(26, 38, 35, 0.7); }
  .line-10 { animation-delay: 0.65s; stroke: rgba(26, 38, 35, 0.7); }

  @keyframes drawLine {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Occasional faint pulse along key circuit path */
  .pulse-line {
    fill: none;
    stroke: var(--emerald-soft);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 40 800;
    stroke-dashoffset: 840;
    opacity: 0;
    animation: travelingPulse 7s linear infinite 2.2s;
  }

  @keyframes travelingPulse {
    0% {
      stroke-dashoffset: 840;
      opacity: 0;
    }
    10% {
      opacity: 0.75;
    }
    40% {
      stroke-dashoffset: 0;
      opacity: 0.75;
    }
    50%, 100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }

  /* Node Appearance */
  .node-group {
    opacity: 0;
    animation: fadeInNode 0.8s ease-out forwards;
  }

  .node-ai { animation-delay: 0.5s; }
  .node-workflows { animation-delay: 0.7s; }
  .node-pipelines { animation-delay: 0.9s; }
  .node-crm { animation-delay: 0.6s; }
  .node-calendars { animation-delay: 1.1s; }
  .node-forms { animation-delay: 1.0s; }
  .node-sms { animation-delay: 1.2s; }
  .node-api { animation-delay: 1.3s; }

  @keyframes fadeInNode {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .node-halo {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
    opacity: 0.6;
  }

  .node-core {
    fill: var(--line);
    stroke: var(--surface);
    stroke-width: 1;
  }

  .node-core.active {
    fill: var(--emerald-soft);
    stroke: var(--surface);
  }

  .node-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    fill: var(--text-muted);
    opacity: 0.85;
  }

  /* Foreground Content */
  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-content {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Systems Online Status Pill */
  .status-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.35rem 0.85rem;
    background-color: rgba(13, 18, 17, 0.8);
    border: 1px solid var(--line);
    border-radius: 999px;
    width: fit-content;
    backdrop-filter: blur(8px);
  }

  .status-beacon {
    position: relative;
    width: 8px;
    height: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .beacon-dot {
    width: 6px;
    height: 6px;
    background-color: var(--emerald-soft);
    border-radius: 50%;
    display: block;
    box-shadow: 0 0 8px var(--emerald-soft);
  }

  .beacon-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--emerald-soft);
    opacity: 0.4;
    animation: beaconPulse 2.5s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
  }

  @keyframes beaconPulse {
    0% {
      transform: scale(0.8);
      opacity: 0.7;
    }
    70% {
      transform: scale(1.8);
      opacity: 0;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  .status-text {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--emerald-soft);
    letter-spacing: 0.1em;
  }

  /* Role Line with Non-Stranded Atomic Wraps */
  .role-line {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: 0.03em;
    line-height: var(--leading-snug);
    margin: 0;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .role-unit {
    display: inline;
  }

  .role-separator {
    color: var(--emerald-soft);
    opacity: 0.7;
  }

  /* Only apply unbreakable nowrap where viewport is wide enough (>= 480px) */
  /* Below 480px (e.g. 360px), natural word-wrap applies to prevent horizontal overflow */
  @media (min-width: 480px) {
    .role-unit {
      display: inline-block;
      white-space: nowrap;
    }
  }

  /* Hero Headline */
  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.5vw, 4rem);
    font-weight: 700;
    color: var(--text);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0;
    text-wrap: balance;
  }

  /* "invisible" word fade-in */
  .word-invisible {
    display: inline-block;
    color: var(--text);
    opacity: 0.12;
    animation: resolveInvisible 1.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s forwards;
    text-shadow: 0 0 24px rgba(46, 139, 110, 0.35);
  }

  @keyframes resolveInvisible {
    from {
      opacity: 0.12;
    }
    to {
      opacity: 1;
    }
  }

  /* Supporting Line */
  .supporting-line {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, var(--text-lg));
    color: var(--text-muted);
    line-height: var(--leading-normal);
    max-width: var(--measure-content);
    margin: 0;
  }

  /* Hero Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .action-primary {
    background-color: var(--surface);
    border: 1px solid var(--emerald-soft);
    color: var(--text);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .action-primary:hover {
    background-color: rgba(46, 139, 110, 0.15);
    border-color: #38a584;
    color: #ffffff;
    box-shadow: 0 0 16px rgba(46, 139, 110, 0.3);
  }

  .action-arrow {
    transition: transform 0.2s ease;
  }

  .action-primary:hover .action-arrow {
    transform: translateX(3px);
  }

  .action-secondary {
    background-color: transparent;
    border: 1px solid var(--line);
    color: var(--text-muted);
  }

  .action-secondary:hover {
    border-color: var(--emerald-soft);
    color: var(--text);
    background-color: rgba(13, 18, 17, 0.6);
  }

  /* Narrow Screens & Responsive Layout */
  @media (max-width: 900px) {
    .system-map-container {
      width: 90%;
      right: -10%;
      opacity: 0.35;
    }
  }

  @media (max-width: 600px) {
    .hero-section {
      padding: 2.5rem 1.25rem;
      min-height: auto;
    }

    .system-map-container {
      width: 130%;
      right: -30%;
      top: 55%;
      opacity: 0.2;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .action-btn {
      width: 100%;
    }
  }

  /* Prefers-Reduced-Motion Override */
  @media (prefers-reduced-motion: reduce) {
    .map-line {
      stroke-dashoffset: 0 !important;
      stroke-dasharray: none !important;
      animation: none !important;
    }

    .pulse-line {
      display: none !important;
    }

    .node-group {
      opacity: 1 !important;
      animation: none !important;
    }

    .word-invisible {
      opacity: 1 !important;
      animation: none !important;
    }

    .beacon-ring {
      animation: none !important;
      opacity: 0.4 !important;
      transform: none !important;
    }

    .action-btn,
    .action-arrow {
      transition: none !important;
    }
  }
</style>
